# Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# SerpAPI Key for Google Flights / Flights search API
SERPAPI_KEY=sua_chave_da_serpapi_aqui

# Server Port
PORT=5000

# Required: generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the generated value after the equals sign; do not commit .env.
JWT_SECRET=
